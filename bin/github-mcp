#!/usr/bin/env python3
"""
AI-AGENTS GITHUB MCP CLIENT (SEC-04)
==============================================================================
Invokes official GitHub MCP Server (ghcr.io/github/github-mcp-server) via Docker
using standard JSON-RPC stdio protocol.

Usage:
  bin/github-mcp tools
  bin/github-mcp call <tool_name> [json_arguments]
  bin/github-mcp get-me
  bin/github-mcp list-branches [owner] [repo]
  bin/github-mcp list-prs [owner] [repo]
  bin/github-mcp create-pr <title> <head_branch> <base_branch> [body]
==============================================================================
"""

import sys
import os
import json
import subprocess

def get_github_token():
    token = os.environ.get("GITHUB_PERSONAL_ACCESS_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        return token
    # Try macOS keychain
    try:
        out = subprocess.check_output(
            'printf "protocol=https\\nhost=github.com\\n" | git credential-osxkeychain get 2>/dev/null',
            shell=True
        ).decode()
        for line in out.splitlines():
            if line.startswith("password="):
                return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return None

def get_repo_owner_and_name():
    try:
        url = subprocess.check_output("git remote get-url origin", shell=True, text=True).strip()
        # git@github.com:owner/repo.git or https://github.com/owner/repo.git
        if url.endswith(".git"):
            url = url[:-4]
        if "github.com:" in url:
            parts = url.split("github.com:")[1].split("/")
        elif "github.com/" in url:
            parts = url.split("github.com/")[1].split("/")
        else:
            return None, None
        return parts[0], parts[1]
    except Exception:
        return None, None

class GitHubMCPClient:
    def __init__(self, token):
        self.token = token
        self.container_name = f"github-mcp-{os.getpid()}"
        # Prune any previous orphan github-mcp containers
        try:
            subprocess.run(
                'docker rm -f $(docker ps -q --filter ancestor=ghcr.io/github/github-mcp-server) 2>/dev/null',
                shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

        self.proc = subprocess.Popen(
            [
                "docker", "run", "-i", "--rm",
                "--init",
                "--name", self.container_name,
                "-e", f"GITHUB_PERSONAL_ACCESS_TOKEN={self.token}",
                "ghcr.io/github/github-mcp-server", "stdio"
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        self._initialize()

    def _send_rpc(self, method, params=None, req_id=1):
        payload = {"jsonrpc": "2.0", "id": req_id, "method": method}
        if params is not None:
            payload["params"] = params
        self.proc.stdin.write(json.dumps(payload) + "\n")
        self.proc.stdin.flush()
        line = self.proc.stdout.readline()
        if not line:
            return None
        return json.loads(line)

    def _initialize(self):
        self._send_rpc("initialize", {
            "protocolVersion": "2024-11-05",
            "capabilities": {},
            "clientInfo": {"name": "ai-agents-cli", "version": "1.0"}
        }, 1)
        # Send initialized notification
        notif = {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}}
        self.proc.stdin.write(json.dumps(notif) + "\n")
        self.proc.stdin.flush()

    def call_tool(self, name, arguments=None):
        if arguments is None:
            arguments = {}
        res = self._send_rpc("tools/call", {
            "name": name,
            "arguments": arguments
        }, 2)
        if not res:
            return None
        if "error" in res:
            return {"error": res["error"]}
        content = res.get("result", {}).get("content", [])
        if content and len(content) > 0:
            raw_text = content[0].get("text", "")
            try:
                return json.loads(raw_text)
            except Exception:
                return raw_text
        return res.get("result")

    def list_tools(self):
        res = self._send_rpc("tools/list", {}, 2)
        return [t["name"] for t in res.get("result", {}).get("tools", [])]

    def close(self):
        try:
            if self.proc.stdin:
                self.proc.stdin.close()
            self.proc.terminate()
            self.proc.wait(timeout=2)
        except Exception:
            pass
        # Ensure the container is forcefully killed and removed immediately
        try:
            subprocess.run(
                ["docker", "rm", "-f", self.container_name],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
        except Exception:
            pass

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0)

    token = get_github_token()
    if not token:
        print("[ERROR] GitHub token not found in env (GITHUB_PERSONAL_ACCESS_TOKEN) or Keychain.", file=sys.stderr)
        sys.exit(1)

    cmd = sys.argv[1]
    client = GitHubMCPClient(token)

    try:
        if cmd == "tools":
            tools = client.list_tools()
            print(f"Available GitHub MCP Tools ({len(tools)}):")
            for t in sorted(tools):
                print(f"  - {t}")

        elif cmd == "get-me":
            res = client.call_tool("get_me", {})
            print(json.dumps(res, indent=2))

        elif cmd == "list-branches":
            owner = sys.argv[2] if len(sys.argv) > 2 else None
            repo = sys.argv[3] if len(sys.argv) > 3 else None
            if not owner or not repo:
                owner, repo = get_repo_owner_and_name()
            res = client.call_tool("list_branches", {"owner": owner, "repo": repo})
            print(json.dumps(res, indent=2))

        elif cmd == "list-prs":
            owner = sys.argv[2] if len(sys.argv) > 2 else None
            repo = sys.argv[3] if len(sys.argv) > 3 else None
            if not owner or not repo:
                owner, repo = get_repo_owner_and_name()
            res = client.call_tool("list_pull_requests", {"owner": owner, "repo": repo, "state": "open"})
            print(json.dumps(res, indent=2))

        elif cmd == "create-pr":
            if len(sys.argv) < 5:
                print("Usage: bin/github-mcp create-pr <title> <head_branch> <base_branch> [body]")
                sys.exit(1)
            title = sys.argv[2]
            head = sys.argv[3]
            base = sys.argv[4]
            body = sys.argv[5] if len(sys.argv) > 5 else "Automated Pull Request via AI-Agents GitHub MCP"
            owner, repo = get_repo_owner_and_name()
            res = client.call_tool("create_pull_request", {
                "owner": owner,
                "repo": repo,
                "title": title,
                "head": head,
                "base": base,
                "body": body
            })
            print(json.dumps(res, indent=2))

        elif cmd == "call":
            if len(sys.argv) < 3:
                print("Usage: bin/github-mcp call <tool_name> [json_arguments]")
                sys.exit(1)
            tool_name = sys.argv[2]
            args = {}
            if len(sys.argv) > 3:
                args = json.loads(sys.argv[3])
            res = client.call_tool(tool_name, args)
            if isinstance(res, (dict, list)):
                print(json.dumps(res, indent=2))
            else:
                print(res)

        else:
            print(f"Unknown command: {cmd}", file=sys.stderr)
            sys.exit(1)
    finally:
        client.close()

if __name__ == "__main__":
    main()
